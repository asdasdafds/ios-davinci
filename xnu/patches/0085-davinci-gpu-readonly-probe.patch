+++ b/bsd/dev/davinci_gpu.c
@@ -0,0 +1,144 @@
+/*
+ * davinci (SDM730 / sdmmagpie) Adreno 618: read-only power/clock probe.
+ * First step of the GPU port (hakios-xnu-kernel drivers/gpu/hakios.adreno.c
+ * targets the Adreno 642L / SC7280; every address here is sdmmagpie's).
+ *
+ * Boot-arg davinci_gpuprobe=1 (default off). Runs once, on its own thread,
+ * davinci_gpuprobedelay seconds after boot (default 60). Only READS:
+ *   - GCC branch clocks feeding the GPU block (GCC is always clocked)
+ *   - GPUCC (0x5090000) GDSCs and branch clocks, ONLY if gcc_gpu_cfg_ahb_clk
+ *     is running: reading an unclocked GPUCC can hang the bus
+ *   - the cmd-db pointer the boot loader leaves at 0xc3f000c (AOP msg RAM)
+ * It never touches the GMU (0x506a000), the 3D core (0x5000000) or the SMMU.
+ *
+ * Sources: Xiaomi davinci-p-oss gcc-sdmmagpie.c, gpucc-sdmmagpie.c,
+ * sdmmagpie-gdsc.dtsi, sdmmagpie-gpu.dtsi, sdmmagpie.dtsi.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void davinci_gpu_probe_init(void);
+
+#define GCC_PA                  0x00100000u
+#define GCC_SIZE                0x80000u
+#define GCC_GPU_CFG_AHB_CBCR    0x71004u        /* gcc_gpu_cfg_ahb_clk: GPUCC register access */
+#define GCC_GPU_MEMNOC_GFX_CBCR 0x7100cu
+#define GCC_GPU_SNOC_DVM_CBCR   0x71018u
+#define GCC_DDRSS_GPU_AXI_CBCR  0x4452cu
+
+#define GPUCC_PA                0x05090000u     /* dt clock_gpucc reg 0x5090000 0x9000 */
+#define GPUCC_SIZE              0x9000u
+#define GPUCC_GX_GDSCR          0x100cu         /* dt gpu_gx_gdsc 0x509100c */
+#define GPUCC_CX_GDSCR          0x106cu         /* dt gpu_cx_gdsc 0x509106c */
+#define GPUCC_CX_GMU_CBCR       0x1098u
+#define GPUCC_CXO_CBCR          0x109cu
+#define GPUCC_GX_CXO_CBCR       0x1060u
+#define GPUCC_GMU_RCGR          0x1120u         /* gpu_cc_gmu_clk_src cmd_rcgr */
+
+#define CMD_DB_PTR_PA           0x0c3f0000u     /* dt qcom,cmd-db@c3f000c, reg 8 bytes */
+#define CMD_DB_PTR_OFF          0x00cu
+
+#define CBCR_CLK_OFF            (1u << 31)
+#define GDSC_PWR_ON             (1u << 31)
+#define GDSC_SW_COLLAPSE        (1u << 0)
+
+static int gpu_sleep_chan;
+
+static void
+gpu_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&gpu_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static void
+cbcr(const char *name, vm_offset_t base, uint32_t off)
+{
+	uint32_t v = rd(base, off);
+	printf("DAVINCI GPU: %-22s @%#x = %#010x (%s)\n", name, off, v,
+	    (v & CBCR_CLK_OFF) ? "off" : "running");
+}
+
+static void
+gpu_probe_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 60;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("davinci_gpuprobedelay", &delay_s, sizeof(delay_s));
+	printf("DAVINCI GPU: read-only probe in %u s\n", delay_s);
+	gpu_wait(delay_s * 1000u);
+
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	if (!gcc) {
+		printf("DAVINCI GPU: GCC map failed\n");
+		goto out;
+	}
+	cbcr("gcc_gpu_cfg_ahb", gcc, GCC_GPU_CFG_AHB_CBCR);
+	cbcr("gcc_gpu_memnoc_gfx", gcc, GCC_GPU_MEMNOC_GFX_CBCR);
+	cbcr("gcc_gpu_snoc_dvm_gfx", gcc, GCC_GPU_SNOC_DVM_CBCR);
+	cbcr("gcc_ddrss_gpu_axi", gcc, GCC_DDRSS_GPU_AXI_CBCR);
+
+	vm_offset_t ptr = ml_io_map(CMD_DB_PTR_PA, 0x1000);
+	if (ptr) {
+		uint64_t lo = rd(ptr, CMD_DB_PTR_OFF), hi = rd(ptr, CMD_DB_PTR_OFF + 4);
+		printf("DAVINCI GPU: cmd-db base (from 0xc3f000c) = %#llx\n", (hi << 32) | lo);
+	}
+
+	if (rd(gcc, GCC_GPU_CFG_AHB_CBCR) & CBCR_CLK_OFF) {
+		printf("DAVINCI GPU: gpu_cfg_ahb clock off: GPUCC not read (would hang the bus)\n");
+		goto out;
+	}
+	vm_offset_t gpucc = ml_io_map(GPUCC_PA, GPUCC_SIZE);
+	if (!gpucc) {
+		printf("DAVINCI GPU: GPUCC map failed\n");
+		goto out;
+	}
+	uint32_t cx = rd(gpucc, GPUCC_CX_GDSCR), gx = rd(gpucc, GPUCC_GX_GDSCR);
+	printf("DAVINCI GPU: cx_gdscr = %#010x (%s, sw_collapse=%u)\n", cx,
+	    (cx & GDSC_PWR_ON) ? "ON" : "off", cx & GDSC_SW_COLLAPSE);
+	printf("DAVINCI GPU: gx_gdscr = %#010x (%s, sw_collapse=%u)\n", gx,
+	    (gx & GDSC_PWR_ON) ? "ON" : "off", gx & GDSC_SW_COLLAPSE);
+	cbcr("gpu_cc_cx_gmu", gpucc, GPUCC_CX_GMU_CBCR);
+	cbcr("gpu_cc_cxo", gpucc, GPUCC_CXO_CBCR);
+	cbcr("gpu_cc_gx_cxo", gpucc, GPUCC_GX_CXO_CBCR);
+	printf("DAVINCI GPU: gpu_cc_gmu_rcgr cmd=%#x cfg=%#x\n",
+	    rd(gpucc, GPUCC_GMU_RCGR), rd(gpucc, GPUCC_GMU_RCGR + 4));
+	printf("DAVINCI GPU: probe done (Adreno 618, chip id 0x06010800, zap a615_zap, pas-id 13)\n");
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+davinci_gpu_probe_init(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	(void)PE_parse_boot_argn("davinci_gpuprobe", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	if (kernel_thread_start(gpu_probe_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("DAVINCI GPU: kernel_thread_start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
